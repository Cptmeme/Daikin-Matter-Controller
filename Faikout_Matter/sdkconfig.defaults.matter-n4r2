# ESP32-S3-MINI with 4 MB flash and 2 MB PSRAM (upstream's -S3-MINI-N4-R2, current Faikout boards)
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="components/ESP32-RevK/partitions_4m.csv"
CONFIG_PARTITION_TABLE_FILENAME="components/ESP32-RevK/partitions_4m.csv"
CONFIG_SPIRAM=y
CONFIG_ESP32S3_SPIRAM_SUPPORT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_MEMTEST=n
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_EXTERNAL=y
CONFIG_REVK_ETHERNET=n
CONFIG_REVK_ETH_KSZ8851SNL=n
CONFIG_REVK_MINI=y
CONFIG_REVK_BUILD_SUFFIX="-S3-MINI-N4-R2-MT"
# Keep Matter's own memory in PSRAM, so internal RAM stays free for Wi-Fi and BLE
CONFIG_ESP_MATTER_MEM_ALLOC_MODE_EXTERNAL=y
CONFIG_CHIP_MEM_ALLOC_MODE_EXTERNAL=y
