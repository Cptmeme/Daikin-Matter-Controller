# The custom PCB in this repo with an ESPC5-12 module instead: ESP32-C5, 4 MB flash, no PSRAM
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=n
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"
CONFIG_SPIRAM=n
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_EXTERNAL=n
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_DEFAULT=y
CONFIG_REVK_ETHERNET=n
CONFIG_REVK_ETH_KSZ8851SNL=n
CONFIG_REVK_MINI=n
CONFIG_REVK_BUILD_SUFFIX="-C5-MT"

# The board has no USB port, so the console goes to its RX0/TX0 header
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=n

# The board has no status LED
CONFIG_REVK_BLINK=""
