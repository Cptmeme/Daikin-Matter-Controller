# --- Faikout's own OTA stays, but never fetches RevK's stock images. Set your own server in the
# web settings if you want automatic updates. Updates must be signed with this project's key.
CONFIG_REVK_OTAHOST=""
CONFIG_REVK_WEB_BETA=n
