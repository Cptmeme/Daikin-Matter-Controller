# Faikout + Matter over Wi-Fi, for all boards. Loaded after sdkconfig.defaults and before the
# file for the board (see CMakeLists.txt). An existing sdkconfig takes priority over all of
# them, so delete it after changing anything here.

# --- ESP-IDF 5.5: esp-matter v1.5 doesn't support IDF 6, which upstream Faikout uses
CONFIG_I2C_ENABLE_SLAVE_DRIVER_VERSION_2=y

# --- Size
CONFIG_COMPILER_OPTIMIZATION_DEBUG=n
CONFIG_COMPILER_OPTIMIZATION_PERF=n
CONFIG_COMPILER_OPTIMIZATION_SIZE=y

# --- Matter: Wi-Fi only, pairing over the network, Faikout's own OTA
CONFIG_ENABLE_CHIPOBLE=n
CONFIG_ENABLE_WIFI_STATION=y
CONFIG_ENABLE_WIFI_AP=n
CONFIG_ENABLE_OTA_REQUESTOR=n
CONFIG_CUSTOM_COMMISSIONABLE_DATA_PROVIDER=y
CONFIG_ENABLE_CHIP_SHELL=n
CONFIG_CHIP_PROJECT_CONFIG="main/CHIPProjectConfig.h"
# The root, the AC, and up to 10 switches
CONFIG_ESP_MATTER_MAX_DYNAMIC_ENDPOINT_COUNT=12
CONFIG_MBEDTLS_HKDF_C=y
CONFIG_LWIP_IPV6_NUM_ADDRESSES=6
CONFIG_LWIP_HOOK_IP6_ROUTE_DEFAULT=y
CONFIG_LWIP_HOOK_ND6_GET_GW_DEFAULT=y

# Keep lwIP core locking, but not the assertion Matter normally turns on with it: Faikout's
# framework makes SNTP calls that it might trip.
CONFIG_USE_TCPIP_CORE_LOCK_FOR_THREAD_SAFETY=n
CONFIG_LWIP_TCPIP_CORE_LOCKING=y
CONFIG_LWIP_CHECK_THREAD_SAFETY=n

# Two mDNS responders share port 5353: Matter's own, and the one that gives Faikout its .local
# name. Matter's sets SO_REUSEADDR. The socket build of Faikout's sets it too, the default doesn't.
CONFIG_USE_MINIMAL_MDNS=y
CONFIG_MDNS_NETWORKING_SOCKET=y
CONFIG_LWIP_SO_REUSE=y
CONFIG_LWIP_SO_REUSE_RXTOALL=y

# --- Leave out the server code of Matter clusters this device never creates
CONFIG_SUPPORT_ACCOUNT_LOGIN_CLUSTER=n
CONFIG_SUPPORT_ACTIONS_CLUSTER=n
CONFIG_SUPPORT_ACTIVATED_CARBON_FILTER_MONITORING_CLUSTER=n
CONFIG_SUPPORT_AIR_QUALITY_CLUSTER=n
