# ESP32-PICO, older Faikin boards: 8 MB flash, 2 MB PSRAM (upstream's -S1-PICO)
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=n
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="8MB"
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="components/ESP32-RevK/partitions_8m.csv"
CONFIG_PARTITION_TABLE_FILENAME="components/ESP32-RevK/partitions_8m.csv"
CONFIG_SPIRAM=y
CONFIG_ESP32_SPIRAM_SUPPORT=y
CONFIG_FREERTOS_UNICORE=n
CONFIG_ESP32_REV_MIN_3=y
CONFIG_SECURE_SIGNED_APPS_NO_SECURE_BOOT=y
CONFIG_SECURE_SIGNED_APPS_RSA_SCHEME=n
CONFIG_SECURE_SIGNED_APPS_ECDSA_SCHEME=y
CONFIG_SECURE_BOOT_SIGNING_KEY="secure_boot_signing_key_ecdsa.pem"
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_EXTERNAL=y
CONFIG_REVK_ETHERNET=n
CONFIG_REVK_ETH_KSZ8851SNL=n
CONFIG_REVK_MINI=n
CONFIG_REVK_PICO=y
CONFIG_REVK_D4=n
CONFIG_REVK_BUILD_SUFFIX="-S1-PICO-MT"
# Keep Matter's own memory in PSRAM, so internal RAM stays free for Wi-Fi and BLE
CONFIG_ESP_MATTER_MEM_ALLOC_MODE_EXTERNAL=y
CONFIG_CHIP_MEM_ALLOC_MODE_EXTERNAL=y

# Status LED, read from the PCB file: red, green and blue on a common-anode LED
CONFIG_REVK_BLINK="-8 -19 -7"
