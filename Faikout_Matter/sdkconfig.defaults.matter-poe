# FaikoutPOE: the same module and Ethernet chip, powered over Ethernet. Reset moves to GPIO 16, and GPIO 36
# drives the load that stops the switch from cutting the power.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"
CONFIG_SPIRAM=y
CONFIG_ESP32S3_SPIRAM_SUPPORT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_MEMTEST=n
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_EXTERNAL=y
CONFIG_REVK_MINI=y

# Ethernet, using the driver built in to ESP-IDF 5
CONFIG_ETH_ENABLED=y
CONFIG_ETH_USE_SPI_ETHERNET=y
CONFIG_ETH_SPI_ETHERNET_KSZ8851SNL=y
CONFIG_REVK_ETHERNET=y
CONFIG_REVK_ETH_KSZ8851SNL=y

# Keep Matter's own memory in PSRAM, so internal RAM stays free for Wi-Fi and BLE
CONFIG_ESP_MATTER_MEM_ALLOC_MODE_EXTERNAL=y
CONFIG_CHIP_MEM_ALLOC_MODE_EXTERNAL=y

# Ethernet pins, read from this board's PCB file
CONFIG_REVK_ETH_CS="10"
CONFIG_REVK_ETH_MOSI="11"
CONFIG_REVK_ETH_CLK="12"
CONFIG_REVK_ETH_MISO="13"
CONFIG_REVK_ETH_WOL="14"
CONFIG_REVK_ETH_INT="-15"
CONFIG_REVK_ETH_RST="-16"
CONFIG_REVK_ETH_POELOAD="-36"
CONFIG_REVK_BUILD_SUFFIX="-S3-MINI-N4-R2-POE-MT"
